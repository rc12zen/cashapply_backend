{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Account config entry",
  "description": "Schema for a single account entry in account_configs.json. Each account owns one or more format recipes.",
  "type": "object",
  "required": ["account_number", "account_last4", "display_name", "recipes"],
  "additionalProperties": true,
  "properties": {
    "account_number": { "type": "string", "minLength": 1 },
    "account_last4":  { "type": "string", "pattern": "^[A-Z0-9]{1,4}$" },
    "bank":           { "type": "string" },
    "currency":       { "type": "string" },
    "display_name":   { "type": "string", "minLength": 1 },

    "recipes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["xlsx", "xls", "csv", "pdf"] },
      "additionalProperties": { "$ref": "#/$defs/recipe" }
    }
  },

  "$defs": {
    "recipe": {
      "type": "object",
      "required": ["account_locator", "source", "fields", "credit_rule"],
      "additionalProperties": true,
      "properties": {
        "account_locator": { "$ref": "#/$defs/account_locator" },
        "source": {
          "type": "object",
          "required": ["engine"],
          "properties": {
            "engine":   { "type": "string", "enum": ["excel", "csv", "pdfplumber"] },
            "sheet":    { "type": "object" },
            "header":   { "type": "object" },
            "encoding": { "type": "string" },
            "delimiter":{ "type": "string" }
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "from"],
            "properties": {
              "name": {
                "type": "string",
                "enum": ["account_number", "currency", "bank_name", "date",
                         "narrative", "credit_amount", "bank_reference"]
              },
              "from": { "$ref": "#/$defs/field_source" }
            }
          }
        },
        "credit_rule": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type":    { "type": "string", "enum": ["amount_positive", "column_not_blank", "flag_matches"] },
            "field":   { "type": "string" },
            "pattern": { "type": "string" }
          }
        },
        "exclusions":   { "type": "array", "items": { "$ref": "#/$defs/exclusion" } },
        "transforms":   { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/transform" } } },
        "date_formats": { "type": "array", "items": { "type": "string" } }
      }
    },

    "account_locator": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type":    { "type": "string", "enum": ["cell", "column", "regex"] },
        "sheet":   { "type": "string" },
        "row":     { "type": "integer" },
        "col":     { "type": "integer" },
        "name":    { "type": "string" },
        "pattern": { "type": "string" },
        "in": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["cell", "column", "sheet"] },
            "row":  { "type": "integer" },
            "col":  { "type": "integer" },
            "name": { "type": "string" }
          }
        }
      }
    },

    "field_source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type":    { "type": "string", "enum": ["column", "cell", "fixed", "concat", "filename_pattern", "none"] },
        "name":    {},
        "names":   { "type": "array", "items": { "type": "string" } },
        "value":   { "type": "string" },
        "row":     { "type": "integer" },
        "col":     { "type": "integer" },
        "sep":     { "type": "string" },
        "pattern": { "type": "string" },
        "group":   { "type": "integer" }
      }
    },

    "exclusion": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type":    { "type": "string", "enum": ["field_value_in", "field_not_equals", "field_blank", "field_matches"] },
        "field":   { "type": "string" },
        "values":  { "type": "array", "items": { "type": "string" } },
        "value":   { "type": "string" },
        "pattern": { "type": "string" }
      }
    },

    "transform": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type":      { "type": "string", "enum": ["strip", "replace", "collapse_whitespace", "strip_prefix", "take_first", "uppercase", "truncate"] },
        "pattern":   { "type": "string" },
        "with":      { "type": "string" },
        "chars":     { "type": "string" },
        "delimiter": { "type": "string" },
        "length":    { "type": "integer" }
      }
    }
  }
}
