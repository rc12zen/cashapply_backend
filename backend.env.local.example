# ── Backend — LOCAL environment ─────────────────────────────────────────────
# Copy to: .env  (pydantic-settings reads ".env" by default — see
# db/settings.py's model_config). Never commit the real .env once filled in.

# Gates the X-Dev-User SSO bypass header (auth/bypass.py) — only ever
# reachable when this is exactly "local". Independent of STORAGE_BACKEND
# below (see db/settings.py's docstring for why they're split).
APP_ENV=local

# Purely "where do files live" — local disk vs Azure Blob. Independent of
# APP_ENV above.
STORAGE_BACKEND=local

# ── Database ─────────────────────────────────────────────────────────────
# Matches the docker-compose/docker-run Postgres instance from earlier —
# adjust user/password/db name/port to whatever you actually created.
DATABASE_URL=postgresql+psycopg2://cashapply2:cashapply2@localhost:5432/cashapply2

# ── Local storage (used when STORAGE_BACKEND=local) ─────────────────────────
LOCAL_STORAGE_ROOT=./storage

# ── Dev/test SSO bypass (auth/bypass.py) ────────────────────────────────────
# Comma-separated list of emails allowed to use the X-Dev-User header. Leave
# blank to allow ANY email the dev-bypass login screen is given, as long as
# a matching row already exists in the users table (see scripts/seed_rbac.py).
DEV_SSO_BYPASS_EMAILS=

# Role auto-assigned to a brand-new user on first login, when/if JIT
# provisioning is enabled. Deliberately the lowest-privilege role.
DEFAULT_NEW_USER_ROLE=Viewer

# ── CORS ─────────────────────────────────────────────────────────────────
# "*" is fine for local dev (frontend usually runs on http://localhost:3000).
CORS_ALLOWED_ORIGINS=*

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_DIR=./logs
LOG_RETENTION_DAYS=30

# ── Azure AD SSO — not required while APP_ENV=local, since the dev-bypass
# above is what's actually used. Leave blank unless you specifically want to
# validate real Azure tokens while running locally.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=

# ── Anthropic / Claude ───────────────────────────────────────────────────
# Required for the extraction pipeline (Layer 2B AI matching) to do anything
# useful — get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Master switch for the Layer 2B AI fallback (extraction/layer_2b_ai.py).
# Default true. Set false in local dev to skip all AI calls and save tokens —
# analysis still runs regex-only, unresolved rows land as "unidentified", and
# upload/analyse stay allowed (Home badge shows "AI Extraction Off"). Keep true
# in UAT/prod.
AI_EXTRACTION_ENABLED=true

# ── Oracle Fusion ────────────────────────────────────────────────────────
# Point at a TEST/non-production Oracle Fusion instance for local work.
ORACLE_FUSION_BASE_URL=https://fa-etvl-test-saasfaprod1.fa.ocs.oraclecloud.com/fscmRestApi/resources/latest
ORACLE_AUTH_MODE=basic
ORACLE_BASIC_USERNAME=
ORACLE_BASIC_PASSWORD=

# ── Remittance fetch source ──────────────────────────────────────────────
REMITTANCE_SOURCE=local_folder
REMITTANCE_LOCAL_FOLDER=./remittance_inbox_local
REMITTANCE_RECHECK_INTERVAL_SECONDS=300

# ── Aging report auto-detection ──────────────────────────────────────────
AGING_SOURCE=local_folder
AGING_WATCH_FOLDER=./aging_watch
AGING_POLL_INTERVAL_SECONDS=30
