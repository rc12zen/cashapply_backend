# ── Environment switch ────────────────────────────────────────────────────
# "local"  -> local disk storage, Azure SSO bypass reachable via X-Dev-User
# "azure"  -> Azure Blob storage, SSO bypass code path is unreachable
ENVIRONMENT=local

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://cashapply:cashapply@localhost:5432/cashapply

# ── Local storage (ENVIRONMENT=local) ────────────────────────────────────
LOCAL_STORAGE_ROOT=./storage

# ── Azure Blob Storage (ENVIRONMENT=azure) ────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_CONTAINER_BANK_STATEMENTS=bank-statements
AZURE_CONTAINER_AGING_REPORTS=aging-reports
AZURE_CONTAINER_REMITTANCE_INBOX=remittance-inbox

# ── Anthropic / Claude — REQUIRED, no default (see security note in the
#    design doc — a previous revision shipped a real key as a code default) ─
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Master switch for the Layer 2B AI fallback (extraction/layer_2b_ai.py).
# Default true. Set false in local dev to skip all AI calls and save tokens —
# analysis still runs regex-only, unresolved rows land as "unidentified", and
# upload/analyse stay allowed (Home badge shows "AI Extraction Off"). Keep true
# in UAT/prod.
AI_EXTRACTION_ENABLED=true

# ── Oracle Fusion — REQUIRED for real posting, no default ────────────────
ORACLE_FUSION_BASE_URL=https://fa-etvl-test-saasfaprod1.fa.ocs.oraclecloud.com/fscmRestApi/resources/latest/standardReceipts
ORACLE_AUTH_MODE=basic
ORACLE_BASIC_USERNAME=
ORACLE_BASIC_PASSWORD=
ORACLE_OAUTH_TOKEN_URL=
ORACLE_OAUTH_CLIENT_ID=
ORACLE_OAUTH_CLIENT_SECRET=

# ── Auth: Microsoft Entra ID (Azure AD) SSO ───────────────────────────────
# Leave both blank for pure local-bypass testing (see DEV_SSO_BYPASS_EMAILS
# below) — real token validation will simply fail with a clear error until
# these are set, which is fine as long as ENVIRONMENT=local and you're using
# the X-Dev-User header instead.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_JWKS_CACHE_SECONDS=3600

# Comma-separated emails allowed to use the X-Dev-User bypass header.
# ONLY reachable when ENVIRONMENT=local — see app/auth/bypass.py.
DEV_SSO_BYPASS_EMAILS=admin@example.com,analyst@example.com

# Role auto-assigned to a brand-new user on first successful real SSO login.
DEFAULT_NEW_USER_ROLE=Viewer

# ── Aging report auto-detection (unchanged) ───────────────────────────────
AGING_SOURCE=local_folder
AGING_WATCH_FOLDER=./aging_watch
AGING_POLL_INTERVAL_SECONDS=30

# ── Rule engine tolerances (unchanged) ────────────────────────────────────
SHORT_PAYMENT_TOLERANCE_PCT=12.0
BANK_CHARGE_SPOC_AUTHORITY=50.0
CUSTOMER_FUZZY_MATCH_MIN_PCT=40.0

# ── Chunk / threading configuration (unchanged) ───────────────────────────
CHUNK_SIZE=15
CHUNK_MAX_WORKERS=4
AI_BATCH_SIZE=10
AI_BATCH_MAX_CONCURRENCY=4

# ── Remittance fetch source (unchanged) ───────────────────────────────────
REMITTANCE_SOURCE=local_folder
REMITTANCE_LOCAL_FOLDER=./remittance_inbox_local
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX_USER=

# ── Logging ──────────────────────────────────────────────────────────────
# local -> ./logs. UAT -> /var/cashapply/logs (see backend.env.uat.example). 
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION_DAYS=90
