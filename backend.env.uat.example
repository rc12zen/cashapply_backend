# ── Backend — UAT environment ───────────────────────────────────────────────
# Copy to: .env on the UAT server (or set as real environment variables
# through whatever deploys it). Never commit this once filled in with real
# secrets/credentials.

# Disables the X-Dev-User bypass entirely (auth/bypass.py is only ever
# importable when this is exactly "local") — every request must carry a
# real, validated Azure AD token. This is the one setting that actually
# matters for "is this environment using real SSO".
APP_ENV=uat

# This app runs on a single VM per design — local disk storage is fine even
# in UAT. Switch to "azure" + fill in the Azure Blob settings below if UAT
# is meant to mirror prod's storage backend too.
STORAGE_BACKEND=local

# ── Database ─────────────────────────────────────────────────────────────
# Point at the real UAT Postgres instance — not the local Docker one from
# earlier. Get the actual host/credentials from whoever provisioned it.
DATABASE_URL=postgresql+psycopg2://<uat-db-user>:<uat-db-password>@<uat-db-host>:5432/<uat-db-name>

# ── Local storage (used when STORAGE_BACKEND=local) ─────────────────────────
LOCAL_STORAGE_ROOT=/var/cashapply/storage

# ── Dev/test SSO bypass — LEAVE EMPTY. APP_ENV=uat already makes
# auth/bypass.py unreachable regardless of this value, but keep it empty
# for clarity/defense-in-depth rather than relying on that alone.
DEV_SSO_BYPASS_EMAILS=

# Role auto-assigned to a brand-new user on first login, if/when JIT
# provisioning is turned on. Until then, every user must be onboarded via
# the Users tab (or scripts/seed_rbac.py --dev-user) before they can sign in
# — see the "invite-only" note in auth/dependencies.py.
DEFAULT_NEW_USER_ROLE=Viewer

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list — the UAT frontend's real origin(s), NOT "*". Add
# more than one, comma-separated, if UAT is reachable at multiple domains.
CORS_ALLOWED_ORIGINS=https://cashapply-uat.zensar.com

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=/var/cashapply/logs
LOG_RETENTION_DAYS=90

# ── Azure AD SSO (required in this environment) ─────────────────────────────
AZURE_TENANT_ID=
# Backend API's own App Registration client id (the token audience this
# backend validates incoming Bearer tokens against) — see
# auth/azure_validator.py. May be the same App Registration as the
# frontend's client id, or a different one that accepts its tokens; confirm
# with whoever set up the Azure App Registrations.
AZURE_CLIENT_ID=
AZURE_JWKS_CACHE_SECONDS=3600

# ── Anthropic / Claude ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Master switch for the Layer 2B AI fallback (extraction/layer_2b_ai.py).
# Default true. Set false in local dev to skip all AI calls and save tokens —
# analysis still runs regex-only, unresolved rows land as "unidentified", and
# upload/analyse stay allowed (Home badge shows "AI Extraction Off"). Keep true
# in UAT/prod.
AI_EXTRACTION_ENABLED=true

# ── Oracle Fusion ────────────────────────────────────────────────────────
# UAT should point at Oracle's TEST/non-production instance, not the real
# production Fusion environment.
ORACLE_FUSION_BASE_URL=https://fa-etvl-test-saasfaprod1.fa.ocs.oraclecloud.com/fscmRestApi/resources/latest/standardReceipts
ORACLE_AUTH_MODE=basic
ORACLE_BASIC_USERNAME=
ORACLE_BASIC_PASSWORD=

# ── Remittance fetch source ──────────────────────────────────────────────
# Switch to graph_api once UAT is wired to a real mailbox; local_folder is
# fine for early UAT testing.
REMITTANCE_SOURCE=local_folder
REMITTANCE_LOCAL_FOLDER=/var/cashapply/remittance_inbox
REMITTANCE_RECHECK_INTERVAL_SECONDS=300
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_MAILBOX_USER=

# ── Aging report auto-detection ──────────────────────────────────────────
AGING_SOURCE=local_folder
AGING_WATCH_FOLDER=/var/cashapply/aging_watch
AGING_POLL_INTERVAL_SECONDS=30

# ── API payload encryption (VAPT remediation) — REQUIRED HERE ────────────
# Encryption is ON by default in every environment, so
# API_ENCRYPTION_ENABLED does not need setting here. But the key DOES: the
# process will refuse to start without it, deliberately, so that a
# misconfigured deploy fails visibly at boot instead of 500-ing on every
# request afterwards.
#
# Mint a FRESH one for this environment -- do not copy the sample value from
# backend.env.local.example. That one is in version control, so anything
# using it is readable by anyone with repo access.
#
# Mint one with `python -m scripts.gen_api_key` and set the SAME value as
# NEXT_PUBLIC_API_ENCRYPTION_KEY in this environment's frontend BUILD.
# Use a DIFFERENT key per environment, so a key lifted out of the UAT
# frontend bundle decrypts nothing in prod.
# There is no key-id to set: every payload carries a short fingerprint
# derived from the key itself, so the two sides agree without a shared
# label and there is nothing to keep in sync. The server logs the
# fingerprint at startup if you need to confirm which key is live.
API_ENCRYPTION_KEY=

# Set this ONLY while rotating the key, then remove it once the frontend
# has been rebuilt. The backend seals with the current key while still
# accepting the previous one, which is what lets the backend and frontend
# deploy separately instead of in the same instant:
#
#   1. New key -> API_ENCRYPTION_KEY; old key -> the _PREVIOUS line below.
#      Deploy backend. The live frontend keeps working on the old key.
#   2. Rebuild + deploy the frontend with the new key.
#   3. Delete the _PREVIOUS line whenever convenient.
#
# API_ENCRYPTION_KEY_PREVIOUS=
#
# TLS is a hard requirement, not a recommendation: the browser withholds
# crypto.subtle entirely outside a secure context, so the frontend cannot
# decrypt anything if this environment is served over plain HTTP.
